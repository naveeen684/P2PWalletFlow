# Local Docker Compose configuration. Add required secrets only to your local .env.
POSTGRES_DB=wallet
# Required locally: POSTGRES_USER
# Required locally: POSTGRES_PASSWORD
# Required locally: WALLET_TOKEN_PEPPER
# Required locally: WALLET_BOOTSTRAP_ADMIN_TOKEN

# Required for direct Maven startup:
# SPRING_DATASOURCE_URL
# SPRING_DATASOURCE_USERNAME
# SPRING_DATASOURCE_PASSWORD
# Render/Neon: use JDBC-form URLs without credentials in the authority section.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<pooled-host>/<database>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-role>
